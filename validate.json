{
  "_": "Naming policy: kebab-case generally, snake_case for Python modules.",
  "required-files": {
    "paths": [
      "AGENTS.md",
      "CONTRIBUTING.md",
      "README.md",
      "LICENSE",
      "SECURITY.md",
      "CATALOG.md"
    ]
  },
  "path-names": {
    "enabled": true,
    "rules": [
      {
        "_": "Tool-owned directories follow their tools' conventions.",
        "pattern": "^.*$",
        "scope": [
          ".github",
          ".github/**",
          ".githooks",
          ".githooks/**",
          ".vscode",
          ".vscode/**"
        ]
      },
      {
        "_": "Python modules in Python-owned directories.",
        "pattern": "^(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*|__init__)\\.py$",
        "scope": [
          "scripts/*.py",
          "tests/*.py"
        ]
      },
      {
        "_": "Each template directory carries exactly these two documents.",
        "pattern": "^.*$",
        "scope": [
          "templates/*/README.md",
          "templates/*/standard.md"
        ]
      },
      {
        "_": "Root documents and tool configuration files.",
        "pattern": "^.*$",
        "scope": [
          "*.md",
          "LICENSE",
          ".editorconfig",
          ".gitattributes",
          ".gitignore",
          ".markdownlint-cli2.jsonc",
          "scripts",
          "tests",
          "validate.json"
        ]
      },
      {
        "_": "Everything else is kebab-case.",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+)*$",
        "scope": [
          "**"
        ]
      }
    ]
  },
  "structure-snapshot": {
    "enabled": true
  }
}
